---
import { buttonVariants } from "@/components/ui/button"
import { navLinks } from "@/config/site"
import { cn } from "@/lib/utils"
import { Brand } from "./Brand"
import Container from "./Container.astro"
import { MobileNav } from "./MobileNav"

interface Props {
  /** Start transparent over a full-bleed hero, turning solid on scroll. */
  overlay?: boolean
}

const { overlay = false } = Astro.props
const path = Astro.url.pathname
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href)
---

<header
  data-site-header
  data-overlay={String(overlay)}
  data-solid={String(!overlay)}
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[solid=true]:border-border data-[solid=true]:bg-background/80 data-[solid=true]:backdrop-blur-xl"
>
  <Container class="flex h-16 items-center justify-between gap-6">
    <Brand />
    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class={cn(
            buttonVariants({ variant: "ghost", size: "sm" }),
            "px-3 text-foreground/70 hover:text-foreground aria-[current=page]:text-foreground",
          )}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact/"
        aria-current={isActive("/contact/") ? "page" : undefined}
        class={cn(buttonVariants({ size: "sm" }), "ml-3 px-3.5")}
      >
        Contact
      </a>
    </nav>
    <MobileNav client:media="(max-width: 47.99rem)" currentPath={path} />
  </Container>
</header>

<script>
  import "@/scripts/header"
</script>

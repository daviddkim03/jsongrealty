---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<p
  class={cn(
    "flex items-center gap-3 text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase",
    className,
  )}
>
  <span class="h-px w-6 bg-current opacity-60" aria-hidden="true"></span>
  <slot />
</p>

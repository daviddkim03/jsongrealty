---
import { LuCheck, LuFileText, LuStar } from "react-icons/lu"

import { GuideForm } from "@/components/forms/GuideForm"
import { ValuationForm } from "@/components/forms/ValuationForm"
import CtaBand from "@/components/site/CtaBand.astro"
import Eyebrow from "@/components/site/Eyebrow.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Panel from "@/components/site/Panel.astro"
import Section from "@/components/site/Section.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import { site } from "@/config/site"
import Layout from "@/layouts/Layout.astro"

const stats = [
  { value: "50+", label: "Atlanta transactions" },
  { value: "$25M+", label: "Volume closed" },
  { value: "< 1 hr", label: "Avg. weekday response" },
  { value: "9 days", label: "Avg. offer to ratify" },
  { value: "5.0", label: "Average client rating", star: true },
]

const guideContents = [
  "Atlanta submarket cheat sheet — what's moving fast, what's sitting, and why",
  "The 7 pre-listing prep moves with the highest ROI (and the 3 to skip)",
  "How to read a CMA — and the questions to ask before agreeing on a list price",
  "Pre-listing inspection: when it's worth it, when it's not",
  "Offer-evaluation worksheet — comparing offers beyond the headline price",
  "Closing-day timeline and what your settlement statement actually means",
]
---

<Layout
  title="Work with Joshua — JSong Realty | Atlanta Buying & Selling"
  description="Buy or sell an Atlanta home with Joshua Song — Keller Williams Realty. A clear, data-first approach with vetted vendors and zero noise."
>
  <PageHeader current="Services">
    Buy or sell in Atlanta&nbsp;—{" "}
    <em class="text-foreground/65">without the noise.</em>
    <Fragment slot="description">
      A straightforward, data-first approach for both sides of the table — from
      first conversation to closing day.
    </Fragment>
  </PageHeader>

  <Section>
    <SectionHeading eyebrow="Why work with Joshua">
      What you can count on.
      <Fragment slot="description">
        Buying or selling a home is one of the most consequential financial
        decisions you'll make. Here's what working with Joshua is built around.
      </Fragment>
    </SectionHeading>

    <dl
      class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-border ring-1 ring-foreground/10 md:grid-cols-5"
      data-reveal
    >
      {stats.map((stat) => (
        <div class="flex flex-col-reverse gap-2 bg-card px-4 py-8 text-center last:col-span-2 md:last:col-span-1">
          <dt class="text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase">
            {stat.label}
          </dt>
          <dd class="flex items-center justify-center gap-1.5 font-heading text-4xl tracking-tight">
            {stat.value}
            {stat.star && (
              <LuStar className="size-6 fill-current" aria-hidden="true" />
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section tone="muted">
    <div data-reveal>
      <Panel class="grid gap-12 p-6 sm:p-10 lg:grid-cols-2 lg:items-center lg:gap-16 lg:p-14">
        <div>
          <Eyebrow>Selling? Start here</Eyebrow>
          <h2 class="mt-5 text-4xl leading-[1.08] tracking-tight sm:text-5xl">
            What’s your home worth?
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            Receive a thorough Comparative Market Analysis within 24 hours —
            grounded in recent closed sales within your submarket, prepared
            personally for your property.
          </p>
          <div class="mt-8 flex items-center gap-3">
            <img
              src={site.agent.portrait}
              alt=""
              width="44"
              height="44"
              loading="lazy"
              class="size-11 rounded-full object-cover ring-1 ring-foreground/10"
            />
            <div class="leading-tight">
              <p class="text-sm font-medium">Prepared by {site.agent.name}</p>
              <p class="mt-1 text-sm text-muted-foreground">
                {site.agent.title} · {site.agent.brokerage}
              </p>
            </div>
          </div>
        </div>
        <ValuationForm client:visible />
      </Panel>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="Free download">
      The Atlanta Seller’s Guide.
      <Fragment slot="description">
        A working playbook covering prep priorities, pricing strategy,
        marketing, offer evaluation, and closing — with current submarket
        benchmarks and worksheets you'll actually use.
      </Fragment>
    </SectionHeading>

    <div
      class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]"
      data-reveal
    >
      <Panel class="p-6 sm:p-10">
        <h3 class="text-2xl tracking-tight">What’s inside</h3>
        <ul class="mt-6 space-y-4">
          {guideContents.map((item) => (
            <li class="flex gap-3 leading-relaxed text-pretty text-muted-foreground">
              <LuCheck
                className="mt-1 size-4 shrink-0 text-foreground"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>
      </Panel>
      <Panel class="p-6 sm:p-10">
        <div class="flex size-11 items-center justify-center rounded-lg border bg-muted/40">
          <LuFileText className="size-5" aria-hidden="true" />
        </div>
        <h3 class="mt-5 text-2xl tracking-tight">Get the full PDF</h3>
        <p class="mt-2 text-pretty text-muted-foreground">
          Enter your name and email and the guide downloads right away.
        </p>
        <div class="mt-8">
          <GuideForm client:visible />
        </div>
      </Panel>
    </div>
  </Section>

  <CtaBand
    tone="muted"
    eyebrow="Let's talk"
    title="Ready when you are."
    description="Buying, selling, or simply exploring your options — begin with a complimentary 30-minute consultation, with no pressure and no obligation."
    cta={{ href: "/contact/", label: "Talk to Joshua" }}
  />
</Layout>

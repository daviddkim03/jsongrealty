---
import {
  LuArrowRight,
  LuBadgeCheck,
  LuListChecks,
  LuMapPin,
  LuMessagesSquare,
} from "react-icons/lu"

import { ListingGrid } from "@/components/listings/ListingGrid"
import Container from "@/components/site/Container.astro"
import CtaBand from "@/components/site/CtaBand.astro"
import Eyebrow from "@/components/site/Eyebrow.astro"
import { FeatureCard } from "@/components/site/FeatureCard"
import { ReviewCard } from "@/components/site/ReviewCard"
import Section from "@/components/site/Section.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import { badgeVariants } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { site } from "@/config/site"
import { listings } from "@/data/listings"
import { reviews } from "@/data/reviews"
import Layout from "@/layouts/Layout.astro"
import { unsplashSrcSet, unsplashUrl } from "@/lib/images"
import { cn } from "@/lib/utils"

const heroPhoto = "photo-1600596542815-ffad4c1539a9"
const interiorPhoto = "photo-1600607687939-ce8a6c25118c"

const features = [
  {
    icon: LuListChecks,
    title: "A private, curated search",
    description:
      "Share your criteria and receive a curated shortlist of homes, including off-market options, instead of an endless feed of listings.",
  },
  {
    icon: LuBadgeCheck,
    title: "Verified property data",
    description:
      "Square footage, tax history, and school zones verified before you ever schedule a showing — so every decision rests on facts.",
  },
  {
    icon: LuMessagesSquare,
    title: "Responsive by default",
    description:
      "Calls, texts, and emails returned within the hour on weekdays — you will never be left waiting for an answer.",
  },
]
---

<Layout
  title="JSong Realty — Joshua Song | Atlanta Real Estate with Keller Williams Realty"
  ogTitle="JSong Realty — Atlanta Real Estate with Joshua Song"
  ogDescription="Intown Atlanta real estate, handled with precision."
  overlayHeader
>
  <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden pt-32 pb-16 sm:pb-20 lg:pb-24">
    <img
      src={unsplashUrl(heroPhoto, 1920)}
      srcset={unsplashSrcSet(heroPhoto, [960, 1440, 1920, 2560])}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 -z-20 size-full object-cover"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-background/45 lg:hidden"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-linear-to-t from-background via-background/50 to-background/0"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 hidden bg-linear-to-r from-background/90 via-background/45 to-transparent lg:block"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 -z-10 h-40 bg-linear-to-b from-background/70 to-transparent"
    ></div>

    <Container class="flex flex-col gap-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl" data-reveal>
        <p
          class={cn(
            badgeVariants({ variant: "outline" }),
            "h-7 gap-1.5 border-foreground/15 bg-background/40 px-3 text-xs text-foreground/90 backdrop-blur-md",
          )}
        >
          <LuMapPin aria-hidden="true" />
          Atlanta · Intown &amp; Beyond
        </p>
        <h1 class="mt-6 text-5xl leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl xl:text-[5.25rem]">
          A home isn’t just an address&nbsp;—{" "}
          <em class="text-foreground/65">it’s a decision.</em>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-foreground/80 sm:text-xl">
          {site.agent.name} is an Atlanta REALTOR® with {site.agent.brokerage} —
          guiding buyers and sellers across Intown and metro Atlanta with clear
          data, honest counsel, and steady representation from the first showing
          to the closing table.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/contact/" class={buttonVariants({ size: "xl" })}>
            Schedule a consultation
            <LuArrowRight aria-hidden="true" data-icon="inline-end" />
          </a>
          <a
            href="/listings/"
            class={cn(
              buttonVariants({ variant: "outline", size: "xl" }),
              "dark:bg-background/40 dark:backdrop-blur-md",
            )}
          >
            Browse listings
          </a>
        </div>
      </div>

      <div
        class="hidden shrink-0 items-center gap-3 rounded-full border border-foreground/15 bg-background/50 py-2 pr-5 pl-2 backdrop-blur-md lg:flex"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        <img
          src={site.agent.portrait}
          alt=""
          width="40"
          height="40"
          class="size-10 rounded-full object-cover"
        />
        <div class="leading-tight">
          <p class="text-sm font-medium">{site.agent.name}</p>
          <p class="mt-1 text-xs text-muted-foreground">
            {site.agent.title} · {site.agent.brokerage}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Section>
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <Eyebrow>Why work with Joshua</Eyebrow>
        <h2 class="mt-5 text-4xl leading-[1.08] tracking-tight sm:text-5xl">
          A modern standard for an old industry.
        </h2>
      </div>
      <div class="lg:pt-11" data-reveal style="--reveal-delay: 120ms">
        <p class="text-lg leading-relaxed text-muted-foreground">
          This practice is built on three commitments: data integrity,
          responsive communication, and honest representation — a standard of
          service designed to earn lifelong clients, not one-time transactions.
        </p>
        <a
          href="/about/"
          class={cn(
            buttonVariants({ variant: "link" }),
            "mt-4 h-auto px-0 text-foreground",
          )}
        >
          More about the approach
          <LuArrowRight aria-hidden="true" data-icon="inline-end" />
        </a>
      </div>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {features.map((feature, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <FeatureCard {...feature} />
        </div>
      ))}
    </div>
  </Section>

  <Section tone="muted">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Currently on the market">
        Featured listings
      </SectionHeading>
      <a
        href="/listings/"
        class={cn(
          buttonVariants({ variant: "outline", size: "lg" }),
          "self-start px-4 sm:self-auto",
        )}
      >
        View all listings
        <LuArrowRight aria-hidden="true" data-icon="inline-end" />
      </a>
    </div>
    <div class="mt-12" data-reveal>
      <ListingGrid client:visible listings={listings.slice(0, 3)} featured />
    </div>
  </Section>

  <Section>
    <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
      <div class="relative" data-reveal>
        <img
          src={unsplashUrl(interiorPhoto, 900)}
          srcset={unsplashSrcSet(interiorPhoto, [600, 900, 1200])}
          sizes="(min-width: 1024px) 560px, 100vw"
          alt="Modern open-plan living room and kitchen"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 w-full rounded-2xl object-cover ring-1 ring-foreground/10 sm:aspect-3/2 lg:aspect-4/5"
        />
        <div class="absolute right-4 -bottom-8 max-w-[calc(100%-2rem)] rounded-xl border bg-card/90 p-5 text-balance shadow-2xl shadow-black/50 backdrop-blur-md sm:-right-6 sm:max-w-72">
          <p class="font-heading text-xl italic">Atlanta native.</p>
          <p class="mt-1 text-sm text-muted-foreground">
            Working these streets since 2017.
          </p>
        </div>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <Eyebrow>About Joshua</Eyebrow>
        <h2 class="mt-5 text-4xl leading-[1.08] tracking-tight sm:text-5xl">
          Atlanta roots. <em class="text-foreground/65">Analytical eye.</em>
        </h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted-foreground">
          <p>
            I grew up in these neighborhoods and bring a disciplined,
            research-driven approach to every transaction. Whether you're
            purchasing your first condo Downtown or selling a family home in
            Buckhead, my role is to give you clear numbers, honest options, and
            a confident path forward.
          </p>
          <p>
            I'm licensed in Georgia and affiliated with{" "}
            <strong class="font-medium text-foreground">
              {site.agent.brokerage}
            </strong>
            .
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/about/" class={buttonVariants({ size: "xl" })}>
            More about Joshua
          </a>
          <a
            href="/contact/"
            class={buttonVariants({ variant: "ghost", size: "xl" })}
          >
            Get in touch
            <LuArrowRight aria-hidden="true" data-icon="inline-end" />
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="muted">
    <SectionHeading eyebrow="Client reviews">What people say.</SectionHeading>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {reviews.slice(0, 3).map((review, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <ReviewCard review={review} />
        </div>
      ))}
    </div>
  </Section>

  <CtaBand
    eyebrow="Let's talk"
    title="Ready to start?"
    description="Begin with a brief, no-obligation conversation about your goals — and leave with a clear plan for what comes next."
    cta={{ href: "/contact/", label: "Schedule a call" }}
  />
</Layout>

---
import { ContactForm } from "@/components/forms/ContactForm"
import { ContactDetails } from "@/components/site/ContactDetails"
import PageHeader from "@/components/site/PageHeader.astro"
import Panel from "@/components/site/Panel.astro"
import Section from "@/components/site/Section.astro"
import { listings } from "@/data/listings"
import Layout from "@/layouts/Layout.astro"

const listingOptions = listings.map((listing) => ({
  id: listing.id,
  label: `${listing.street} (${listing.neighborhood})`,
}))
---

<Layout
  title="Contact Joshua Song — JSong Realty | Atlanta"
  description="Get in touch with Joshua Song — Atlanta REALTOR® with Keller Williams Realty. Call, email, or send a message for a private consultation."
>
  <PageHeader current="Contact">
    Let’s start <em class="text-foreground/65">a conversation.</em>
    <Fragment slot="description">
      Share a few details and I'll be in touch — usually within a business day,
      often much sooner.
    </Fragment>
  </PageHeader>

  <Section>
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-8">
      <div class="h-full" data-reveal>
        <Panel class="flex h-full flex-col p-6 sm:p-10">
          <h2 class="text-3xl tracking-tight">Direct</h2>
          <p class="mt-2 text-pretty text-muted-foreground">
            The fastest way to reach me is a call or text.
          </p>
          <div class="mt-10 flex-1">
            <ContactDetails />
          </div>
        </Panel>
      </div>

      <div data-reveal style="--reveal-delay: 120ms">
        <Panel class="p-6 sm:p-10">
          <h2 class="text-3xl tracking-tight">Or send a message</h2>
          <p class="mt-2 text-muted-foreground">
            I'll reply within a business day.
          </p>
          <div class="mt-10">
            <ContactForm client:visible listings={listingOptions} />
          </div>
        </Panel>
      </div>
    </div>
  </Section>
</Layout>

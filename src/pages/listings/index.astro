---
import { ListingGrid } from "@/components/listings/ListingGrid"
import CtaBand from "@/components/site/CtaBand.astro"
import PageHeader from "@/components/site/PageHeader.astro"
import Section from "@/components/site/Section.astro"
import { listings } from "@/data/listings"
import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="Atlanta Home Listings — JSong Realty | Joshua Song"
  description="Featured Atlanta homes for sale with Joshua Song: single-family homes, condos, and townhouses from Intown to Buckhead."
>
  <PageHeader current="Listings">
    Atlanta homes for sale.
    <Fragment slot="description">
      A curated selection of homes across Intown and metro Atlanta. Don't see
      the right fit? I'll set up a private search around your criteria.
    </Fragment>
  </PageHeader>

  <Section>
    <h2 class="sr-only">Available homes</h2>
    <div data-reveal>
      <ListingGrid client:visible listings={listings} />
    </div>
  </Section>

  <CtaBand
    tone="muted"
    eyebrow="Private search"
    title="Can’t find the right home?"
    description="Send me what you're looking for — I'll set up a private search and surface off-market options."
    cta={{ href: "/contact/", label: "Request a private search" }}
  />
</Layout>
